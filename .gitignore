# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of any
# remote Git repository.
*.tfvars
*.tfvars.json

# Ignore any .auto.tfvars and .auto.tfvars.json files, which are likely to contain
# sensitive data.
*.auto.tfvars
*.auto.tfvars.json

# Ignore temporary files created by PyCharm
.idea/

# Ignore virtual environment folders
.venv/
venv/